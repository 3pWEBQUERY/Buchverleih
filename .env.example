# Railway setzt DATABASE_URL über die Variablenreferenz ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leihregal

# Öffentliche Adresse der Web-App (für Links in E-Mails, QR-Codes, Passkeys)
APP_URL=http://localhost:3000

# Railway Storage Bucket (S3-kompatibel). Werte per Variablenreferenz auf den Bucket setzen.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# E-Mail (SMTP-Anbieter mit EU-Standort). Leer = Ausgabe im Log.
SMTP_URL=
MAIL_FROM="Leihregal <hallo@example.ch>"

# SMS: console | aspsms | webhook. Nur für den Code zur Bestätigung der Mobilnummer und Streitfälle ab Tag 7.
# aspsms: Userkey und API-Passwort aus dem ASPSMS-Konto; Absender höchstens 11 Zeichen.
# webhook: {to, text} geht als JSON an SMS_WEBHOOK_URL.
SMS_PROVIDER=console
ASPSMS_USERKEY=
ASPSMS_PASSWORD=
ASPSMS_ORIGINATOR=Leihregal
# Mobilnummer vor der ersten Anfrage bestätigen (PRD 6.1). Nur mit eingerichtetem SMS-Anbieter einschalten.
REQUIRE_PHONE=true
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Nur für lokale Entwicklung und Staging ohne Mail-/SMS-Anbieter:
# zeigt Anmeldelink und SMS-Code direkt in der Oberfläche an.
DEV_SHOW_CODES=true

# Original-Cover laden: DNB (Verlagscover), Open Library, Google Books (Rechte vorab prüfen, PRD 7.2)
COVERS=true
# Google Books API-Schlüssel (Google Cloud Console → «Books API»); nur als Railway-Variable setzen
GOOGLE_BOOKS_API_KEY=

# Admin-Konten (kommagetrennte E-Mail-Adressen). Wer sich mit einer dieser bestätigten
# Adressen anmeldet, wird Admin und kann unter /moderation Moderatoren ernennen.
# Wird eine Adresse entfernt, verliert das Konto die so erhaltene Rolle wieder.
# Ist die Variable gar nicht gesetzt, bleibt alles, wie es ist.
ADMIN_EMAILS=
