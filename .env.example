# Railway setzt DATABASE_URL über die Variablenreferenz ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leihregal

# Öffentliche Adresse der Web-App (für Links in E-Mails, QR-Codes, Passkeys)
APP_URL=http://localhost:3000

# Railway Storage Bucket (S3-kompatibel). Werte per Variablenreferenz auf den Bucket setzen.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# E-Mail (SMTP-Anbieter mit EU-Standort). Leer = Ausgabe im Log.
SMTP_URL=
MAIL_FROM="Leihregal <hallo@example.ch>"

# SMS: console | webhook. Bei webhook wird {to, text} als JSON an SMS_WEBHOOK_URL gesendet.
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Nur für lokale Entwicklung und Staging ohne Mail-/SMS-Anbieter:
# zeigt Anmeldelink und SMS-Code direkt in der Oberfläche an.
DEV_SHOW_CODES=true

# Cover von Open Library zusätzlich laden (Lizenz vorab prüfen, PRD 7.2)
COVERS_OPENLIBRARY=false
